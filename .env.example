# dev-api-proxy example configuration. Copy to .env only when it does not exist.
# Never commit real keys, private client config, or local model metadata.
# Full reference: docs/configuration.md

# Primary server base WITHOUT /v1. AgentRouter is the default, not a requirement.
AGENTROUTER_UPSTREAM=https://agentrouter.org
# Primary fallback order: CODEX_GATEWAY_API_KEY, then AGENTROUTER_API_KEY.
# CODEX_GATEWAY_API_KEY=your-primary-provider-key
# AGENTROUTER_API_KEY=your-primary-provider-key

# Native provider servers. An optional trailing /v1 is normalized away.
XINGCHI_UPSTREAM=https://api.xingchiapi.com
OMNIAI_UPSTREAM=https://sub.omniai.cc
FREEGG_UPSTREAM=https://freegg.app

# Separate keys: never use a key from an unrelated provider.
# Direct native clients can send their own key instead of these fallbacks.
# Cross-provider desktop picker choices require the selected key on the proxy.
# XINGCHI_API_KEY=your-xingchi-key
# OMNIAI_API_KEY=your-omniai-key
# FREEGG_API_KEY=your-freegg-key

# Xingchi only: 0=disabled, 1=metadata filtering, 2=filtering plus header-ID rotation.
# The rotation threshold is 88 incoming requests. State is per process, in memory.
XINGCHI_SESSION_FILTER_MODE=0
# Extra names use the same rules. Do not include required request or auth fields.
XINGCHI_SESSION_FILTER_NAMES=

# Python worker ports. The host is set by --host or the launcher's -BindHost.
# The PowerShell launcher selects its default port by mode; use -Port to override.
PROXY_PORT=8788
CHAT_PROXY_PORT=8789

# Separate local token, sent as X-Proxy-Token. Never use an upstream key here.
# Optional on loopback; required for non-loopback startup. It does not encrypt traffic.
# /_health stays readable for supervisor probes; other routes require this when set.
PROXY_AUTH_TOKEN=

# Example upload ceiling: 1 GiB. The built-in fallback when absent is 20 MiB.
# This local .env value overrides an inherited upload limit.
# Per-request bound only: concurrent uploads can use substantial memory.
# Upstream services can enforce a smaller limit.
PROXY_MAX_BODY_BYTES=1073741824
PROXY_BODY_UPLOAD_TIMEOUT_S=60

# SSE frame and primary initial-inspection bounds: 8 MiB each.
PROXY_MAX_SSE_FRAME_BYTES=8388608
PROXY_MAX_SSE_PRIME_BYTES=8388608

# Upstream timeouts, in seconds. Recovery windows are not total request timeouts.
PROXY_CONNECT_TIMEOUT_S=20.0
PROXY_READ_TIMEOUT_S=600.0
PROXY_RETRY_DELAY_MS=300

# Conservative billing: set both to 0 to disable eligible 5xx and ambiguous retries.
# Connect/pool failures and rate limits can still use applicable recovery.
# No option provides exactly-once execution.
PROXY_RETRY_ON_5XX=1
PROXY_RETRY_AMBIGUOUS_ERRORS=1

# Primary recovery. Native relays and converted provider Chat use different limits.
PROXY_RATE_LIMIT_BASE_S=2.0
# Caps calculated backoff only, never a valid upstream Retry-After hint.
PROXY_RATE_LIMIT_MAX_DELAY_S=15.0
# HTTP window: from initial launch. Transport window: from first transport failure.
PROXY_MAX_RATE_LIMIT_WAIT_S=90.0
PROXY_MAX_TRANSPORT_RECOVERY_WAIT_S=90.0
PROXY_MAX_TRANSIENT_RETRIES=6
PROXY_RECOVERY_STAGGER_S=0.6
PROXY_SSE_PRIME_FIRST_TIMEOUT_S=45.0
PROXY_SSE_PRIME_CREATED_GRACE_S=3.0

# Primary Responses/recovered Chat only, not native provider relays.
PROXY_MAX_IMAGES=35
PROXY_VERBOSE=1

# Used by service.py. Direct Python workers do not start the updater.
# It requires a clean tracked worktree and a valid fast-forward update.
PROXY_AUTO_UPDATE=1
PROXY_AUTO_UPDATE_ON_START=1
PROXY_AUTO_UPDATE_INTERVAL_S=3600
